{
  "name": "@glandjs/core",
  "version": "1.0.3-beta",
  "description": "Glands is a web framework for Node.js",
  "author": "Mahdi",
  "license": "MIT",
  "homepage": "https://github.com/glandjs/gland#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glandjs/gland.git"
  },
  "bugs": {
    "url": "https://github.com/glandjs/gland/issues"
  },
  "keywords": [
    "gland",
    "glandjs",
    "framework",
    "nodejs",
    "di",
    "dependency-injection",
    "event-bus",
    "event-driven",
    "typescript",
    "core",
    "architecture",
    "modular"
  ],
  "engines": {
    "node": ">=22",
    "pnpm": ">=11",
    "typescript": ">=5.0.0"
  },
  "collective": {
    "type": "opencollective",
    "url": "https://opencollective.com/gland",
    "donation": {
      "text": "Become a partner"
    }
  },
  "files": [
    "packages/common",
    "packages/core"
  ],
  "scripts": {
    "dev": "pnpm -r dev",
    "watch": "tsc --watch",
    "build": "pnpm -r build",
    "prebuild": "pnpm typecheck",
    "clean": "pnpm -r clean",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "lint-staged": "lint-staged",
    "check:structure": "node scripts/check-structure.mjs",
    "check:psx": "pnpm dlx @m-mdy-m/psx check",
    "check": "pnpm typecheck && pnpm lint && pnpm check:structure && pnpm test:all",
    "test": "pnpm test:unit",
    "test:unit": "mocha",
    "test:integration": "mocha --spec \"test/integration/**/*.spec.ts\"",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "coverage": "nyc pnpm test:all",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "version": "changeset version",
    "prepare": "husky",
    "release": "pnpm build && pnpm changeset publish",
    "release:alpha": "pnpm build && pnpm changeset publish --tag alpha",
    "release:beta": "pnpm build && pnpm changeset publish --tag beta",
    "release:next": "pnpm build && changeset publish --tag next",
    "mode:dev": "",
    "mode:prod": ""
  },
  "lint-staged": {
    "**/*.ts": "prettier --write"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/chai": "^4.3.19",
    "@types/chai-as-promised": "^7.1.8",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.0.0",
    "@types/sinon": "^17.0.3",
    "chai": "^4.3.7",
    "chai-as-promised": "^7.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "mocha": "^10.7.3",
    "nyc": "^17.1.0",
    "prettier": "^3.5.3",
    "sinon": "^19.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@glandjs/events": "latest",
    "@medishn/toolkit": "latest",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1"
  },
  "packageManager": "pnpm@11.25.0"
}
